# Copy to .env only for local development. Never commit a real key.
DEEPSEEK_API_KEY=

# Unified model configuration. The defaults below may be omitted.
GET_STOCK_LLM_PROVIDER=deepseek
GET_STOCK_LLM_MODEL=deepseek-v4-pro
GET_STOCK_LLM_BASE_URL=https://api.deepseek.com
GET_STOCK_LLM_TEMPERATURE=0
GET_STOCK_LLM_TIMEOUT_SECONDS=120
